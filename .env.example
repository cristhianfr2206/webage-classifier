# Copy to .env. Replace every CHANGE_ME value before starting.
POSTGRES_DB=webage
POSTGRES_USER=webage
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_database_password
DATABASE_URL=postgresql+asyncpg://webage:CHANGE_ME_use_a_long_random_database_password@db:5432/webage
SECRET_KEY=CHANGE_ME_generate_at_least_32_random_bytes
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_use_at_least_16_characters
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]
COOKIE_SECURE=false
LOG_LEVEL=INFO
SESSION_TTL_MINUTES=480
NEXT_PUBLIC_API_URL=http://localhost:8000
INSPECTOR_CONNECT_TIMEOUT_SECONDS=5
INSPECTOR_RESPONSE_TIMEOUT_SECONDS=10
INSPECTOR_MAX_RESPONSE_BYTES=1000000
INSPECTOR_MAX_TEXT_CHARACTERS=50000
INSPECTOR_MAX_REDIRECTS=5
