# Copy to .env. Replace every CHANGE_ME value before starting.
POSTGRES_DB=webage
POSTGRES_USER=webage
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_database_password
DATABASE_URL=postgresql+asyncpg://webage:CHANGE_ME_use_a_long_random_database_password@db:5432/webage
SECRET_KEY=CHANGE_ME_generate_at_least_32_random_bytes
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_use_at_least_16_characters
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]
COOKIE_SECURE=false
LOG_LEVEL=INFO
SESSION_TTL_MINUTES=480
NEXT_PUBLIC_API_URL=http://localhost:8000
INSPECTOR_CONNECT_TIMEOUT_SECONDS=5
INSPECTOR_RESPONSE_TIMEOUT_SECONDS=10
INSPECTOR_MAX_RESPONSE_BYTES=1000000
INSPECTOR_MAX_TEXT_CHARACTERS=50000
INSPECTOR_MAX_REDIRECTS=5
DNS_RESOLUTION_TIMEOUT_SECONDS=3
DNS_MAX_RETRIES=2
REDIS_URL=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=2
TASK_SOFT_TIME_LIMIT_SECONDS=45
TASK_HARD_TIME_LIMIT_SECONDS=60
TASK_MAX_RETRIES=3
DOMAIN_LOCK_TTL_SECONDS=90
MAX_ACTIVE_JOBS=10000
ENQUEUE_RATE_LIMIT=20
ENQUEUE_RATE_WINDOW_SECONDS=60
BULK_ENQUEUE_LIMIT=1000
BROWSER_REDIS_URL=redis://redis:6379/1
BROWSER_WORKER_CONCURRENCY=1
BROWSER_CONTEXTS_PER_WORKER=1
BROWSER_NAVIGATION_TIMEOUT_SECONDS=15
BROWSER_TASK_SOFT_TIME_LIMIT_SECONDS=40
BROWSER_TASK_HARD_TIME_LIMIT_SECONDS=50
BROWSER_MAX_REDIRECTS=5
BROWSER_MAX_REQUESTS=100
BROWSER_MAX_TRANSFERRED_BYTES=5000000
BROWSER_MAX_TEXT_CHARACTERS=50000
BROWSER_MAX_HEADINGS=100
BROWSER_MAX_LINKS=250
BROWSER_MAX_BUTTONS=100
BROWSER_SCREENSHOT_ENABLED=false
BROWSER_SCREENSHOT_WIDTH=1280
BROWSER_SCREENSHOT_HEIGHT=720
BROWSER_SCREENSHOT_MAX_BYTES=2000000
BROWSER_ARTIFACT_ROOT=/artifacts
BROWSER_ARTIFACT_RETENTION_HOURS=24
BROWSER_MAX_RETRIES=2
BROWSER_CONFIDENCE_THRESHOLD=45
BROWSER_MIN_STATIC_TEXT_CHARACTERS=300
BROWSER_ENQUEUE_RATE_LIMIT=5
BROWSER_CHROMIUM_MAX_TASKS=25
AI_ENABLED=false
AI_PROVIDER=disabled
AI_MODEL=
AI_MODEL_VERSION=
AI_API_KEY=
AI_ENDPOINT=
AI_REDIS_URL=redis://redis:6379/2
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARACTERS=20000
AI_MAX_OUTPUT_TOKENS=1000
AI_CONFIDENCE_THRESHOLD=0.75
AI_CONFLICT_THRESHOLD=0.10
AI_SCREENSHOT_ENABLED=false
AI_WORKER_CONCURRENCY=1
AI_DAILY_REQUEST_LIMIT=100
AI_MONTHLY_COST_LIMIT=0
EVALUATION_WORKER_CONCURRENCY=1
EVALUATION_BATCH_SIZE=100
PILOT_CAPACITY_LIMIT=100
PILOT_BROWSER_FALLBACK_RATE=0.20
PILOT_AI_FALLBACK_RATE=0.05
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DOMAIN=5
AI_TEMPERATURE=0
