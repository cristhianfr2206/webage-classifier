FROM python:3.12.4-slim-bookworm AS builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
WORKDIR /build
COPY pyproject.toml .
COPY app ./app
RUN pip wheel --wheel-dir /wheels ".[dev]"

FROM mcr.microsoft.com/playwright/python:v1.49.1-noble
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN groupadd --system browser && useradd --system --gid browser --home /home/browser browser \
    && mkdir -p /app /artifacts /home/browser \
    && chown browser:browser /app /artifacts /home/browser
WORKDIR /app
COPY --from=builder /wheels /wheels
RUN python -m pip install --no-cache-dir /wheels/* && rm -rf /wheels
COPY --chown=browser:browser . .
USER browser
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD ["python", "-c", "from playwright.sync_api import sync_playwright; p=sync_playwright().start(); b=p.chromium.launch(headless=True); b.close(); p.stop()"]
CMD ["celery", "-A", "app.browser_celery_app:browser_celery_app", "worker", "-Q", "browser", "-n", "browser@%h", "--loglevel=INFO", "--concurrency=1"]
